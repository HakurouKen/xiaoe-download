{
  "name": "xiaoe-download",
  "version": "0.1.0",
  "private": true,
  "bin": {
    "xiaoe-download": "dist/cli.mjs"
  },
  "type": "module",
  "scripts": {
    "dev": "tsx src/cli.ts",
    "start": "node dist/cli.mjs",
    "build": "tsdown",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "pnpm build && vitest run --config vitest.e2e.config.ts",
    "lint": "oxlint --type-aware",
    "lint:fix": "oxlint --type-aware --fix",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "typecheck": "tsgo --noEmit",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build"
  },
  "dependencies": {
    "cheerio": "^1.2.0",
    "filenamify": "^7.0.3",
    "puppeteer-core": "^25.13.0"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@types/node": "^24.19.2",
    "@typescript/native-preview": "7.0.0-dev.20260707.2",
    "chrome-devtools-mcp": "^1.10.1",
    "oxfmt": "^0.72.0",
    "oxlint": "^1.87.0",
    "oxlint-tsgolint": "^7.0.2004",
    "tsdown": "^0.23.1",
    "tsx": "^4.23.15",
    "vitest": "^5.0.3"
  },
  "engines": {
    "node": ">=24 <25",
    "pnpm": ">=10 <11"
  },
  "packageManager": "pnpm@10.34.6"
}
